# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# AI
CLAUDE_API_KEY=            # Anthropic API key (invoice vision, item names, suggestions)
VOYAGE_API_KEY=            # Voyage AI embeddings for ingredient matching
VISION_PROVIDER=claude     # "claude" or "gemini"
# AI_DAILY_LIMIT=150       # AI reads one business may start per day (default 150)
# VISION_DEBUG_RAW=1       # log raw vision responses

# Market data
USDA_API_KEY=              # USDA MyMarketNews
# BLS_API_KEY=             # optional; raises the BLS daily quota

# Vercel cron auth for /api/cron/ingest-market-data
CRON_SECRET=

# Access control (optional)
# DOUGHTALLY_ACCESS=closed                 # only allow-listed emails can sign in
# DOUGHTALLY_ALLOWED_EMAILS=a@x.com,b@y.com
# DOUGHTALLY_ADMIN_EMAILS=you@example.com  # who can open /admin
# ENABLED_INDUSTRIES=bakery,food_truck     # industries offered at signup

# Testing only: pin the date the Seasons page uses (YYYY-MM-DD)
# DOUGHTALLY_SEASONS_TODAY=
